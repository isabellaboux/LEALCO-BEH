group_by(error) %>%
summarise(count_mean = mean(n), count_sd = sd(n), perc_mean = mean(perc), perc_sd = sd(perc))
# save
write.csv(overview_bSubj, "output_stats/LEALCO-BEH_trial_overview.csv")
